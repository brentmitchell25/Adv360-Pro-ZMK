        &none  &none  &world_y_base  &world_o_base  &world_u_base  &world_sign_angle  &none    &none  &none    &none  &none    &none  &none  &none  &sk LALT  &sk RALT  &none  &none
        // Row 3: consonants + accented vowels on left; sticky mods on right
        &none  &world_consonants_base  &world_i_base  &world_a_base  &world_e_base  &world_sign_dash    &none                                     &none    &none  &sk LSHFT  &sk LCTRL  &sk RCTRL  &sk RSHFT  &none
        // Row 4: currency + quotes on left; toggle on right
        &world_currency_base  &world_quotes_left_base  &world_sign_landmark  &world_sign_ordinal  &world_sign_exclaim    &world_sign_question  &none  &none    &none  &none  &none    &none  &tog LAYER_World  &none  &none  &none
      >;
