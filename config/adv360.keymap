    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 22: Factory
    //
    // Standard QWERTY factory-default-style layout for recovery.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Factory {
      display-name = "Factory";
      bindings = <
        // Row 0
        &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none                                            &none  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
        // Row 1
        &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &none                                                   &none  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH
        // Row 2
        &kp ESC  &kp A  &kp S  &kp D  &kp F  &kp G  &none    &kp LCTRL  &mo LAYER_Lower    &kp LGUI  &kp RCTRL    &none  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
        // Row 3
        &kp GRAVE  &kp Z  &kp X  &kp C  &kp V  &kp B    &kp LSHFT                                           &kp RSHFT    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp PG_UP
        // Row 4
        &magic LAYER_Magic 0  &kp HOME  &kp END  &kp LEFT  &kp RIGHT    &kp BSPC  &kp DEL  &kp LALT    &kp RALT  &kp RET  &kp SPACE    &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &kp PG_DN
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 23: Lower (v52: was 24, now 23)
    //
    // Keypad numbers, sticky mods, and layer toggles.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Lower {
      display-name = "Lower";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 1
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 2: KP digits 1-5 on left; KP digits 6-0 on right
        &none  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4  &kp KP_N5  &none    &none  &none    &none  &none    &none  &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0  &none
        // Row 3: sticky mods on left; KP operators on right
        &none  &sk LEFT_PINKY_MOD  &sk LEFT_RINGY_MOD  &sk LEFT_MIDDY_MOD  &sk LEFT_INDEX_MOD  &kp KP_MINUS    &tog LAYER_Function                                     &tog LAYER_System    &kp KP_SLASH  &sk RIGHT_INDEX_MOD  &sk RIGHT_MIDDY_MOD  &sk RIGHT_RINGY_MOD  &sk RIGHT_PINKY_MOD  &none
        // Row 4: KP grouping + layer toggles
        &none  &kp KP_LPAR  &kp KP_COMMA  &kp KP_DOT  &kp KP_RPAR    &kp KP_PLUS  &none  &kp RALT    &kp RALT  &none  &none    &kp KP_MULTIPLY  &kp KP_NUM  &kp KP_CLEAR  &kp KP_EQUAL  &kp KP_ENTER
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 24: macOS_lower (v52: was 27, now 24)
    //
    // Overrides sticky mods on both hands for macOS modifier order.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_macOS_lower {
      display-name = "mOSlwr";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 3: macOS-style mods on both home rows
        &trans  &kp LEFT_MIDDY_MOD  &kp LEFT_RINGY_MOD  &kp LEFT_PINKY_MOD  &kp LEFT_INDEX_MOD  &trans    &trans                                     &trans    &trans  &kp RIGHT_INDEX_MOD  &kp RIGHT_PINKY_MOD  &kp RIGHT_RINGY_MOD  &kp RIGHT_MIDDY_MOD  &trans
        // Row 4
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 25: Mouse_slow (v52: renamed from MouseSlow, was 19 now 25)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Mouse_slow {
      display-name = "MsSlow";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &trans    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 26: Mouse_fast (v52: renamed from MouseFast, was 20 now 26)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Mouse_fast {
      display-name = "MsFast";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &trans    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 27: Mouse_warp (v52: renamed from MouseWarp, was 21 now 27)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Mouse_warp {
      display-name = "MsWarp";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &trans    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 28: Magic
    //
    // v52: removed &tog LAYER_Typing from numrow. Uses &to 0 + &tog macOS.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Magic {
      display-name = "Magic";
      bindings = <
        // Row 0: BT clear + profiles
        &bt BT_CLR  &none  &none  &none  &none  &none  &none                                                 &none  &none  &none  &none  &none  &none  &bt BT_CLR_ALL
        // Row 1: base layer select (QWERTY only, macOS toggle)
        &to 0  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 2: RGB controls
        &none  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG  &none    &none  &none    &none  &none    &none  &none  &none  &none  &none  &none  &none
        // Row 3: RGB reverse + bootloader
        &bootloader  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF    &none                                     &none    &none  &none  &none  &none  &none  &bootloader
        // Row 4: reset + BT profiles (0=Mac, 1-4=Win) + USB output + factory
        &sys_reset  &bt_sel_mac  &bt_sel_win1  &bt_sel_win2  &bt_sel_win3    &bt_sel_win4  &out OUT_USB  &tog LAYER_Factory    &none  &none  &none    &none  &none  &none  &tog LAYER_macOS  &sys_reset
      >;
    };

  };
};
