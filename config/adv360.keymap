    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 21: World (v52: moved from 15 to 21)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_World {
      display-name = "World";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 1
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
