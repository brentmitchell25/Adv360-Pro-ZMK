/*
 * Kinesis Advantage 360 Pro - Glorious Engrammer (QWERTY-only port)
 *
 * Ported from sunaku's Glove80 keymap v42-rc9 "Glorious Engrammer"
 * https://github.com/sunaku/glove80-keymaps
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include "positions.h"

//////////////////////////////////////////////////////////////////////////////
//
// Layer index definitions (QWERTY-only: no Enthium/Colemak/Dvorak)
//
//////////////////////////////////////////////////////////////////////////////

#define LAYER_QWERTY      0
#define LAYER_macOS        1
#define LAYER_Typing       2
#define LAYER_LeftPinky    3
#define LAYER_LeftRingy    4
#define LAYER_LeftMiddy    5
#define LAYER_LeftIndex    6
#define LAYER_RightPinky   7
#define LAYER_RightRingy   8
#define LAYER_RightMiddy   9
#define LAYER_RightIndex  10
#define LAYER_Cursor      11
#define LAYER_Number      12
#define LAYER_Function    13
#define LAYER_Emoji       14
#define LAYER_World       15
#define LAYER_Symbol      16
#define LAYER_System      17
#define LAYER_Mouse       18
#define LAYER_MouseSlow   19
#define LAYER_MouseFast   20
#define LAYER_MouseWarp   21
#define LAYER_Gaming      22
#define LAYER_Factory     23
#define LAYER_Lower       24
#define LAYER_macOS_left  25
#define LAYER_macOS_right 26
#define LAYER_macOS_lower 27
#define LAYER_Magic       28


//////////////////////////////////////////////////////////////////////////////
//
// Behaviors, macros, combos, and conditional layers are in keymap.dtsi
//
//////////////////////////////////////////////////////////////////////////////

#define OPERATING_SYSTEM 'M'  // macOS: Cmd on middle finger, Ctrl on pinky
#include "keymap.dtsi"

/ {
  keymap {
    compatible = "zmk,keymap";

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 0: QWERTY (base)
    //
    // Glove80 Row 2 (numrow)  -> Adv360 Row 0 + mod col
    // Glove80 Row 3 (alpha)   -> Adv360 Row 1 + mod col
    // Glove80 Row 4 (home)    -> Adv360 Row 2 + mod col + palm
    // Glove80 Row 5 (lower)   -> Adv360 Row 3 + middle
    // Glove80 Row 6 (bottom)  -> Adv360 Row 4 + thumb
    // Glove80 T1-T6           -> Adv360 thumb/palm/middle
    //
    //////////////////////////////////////////////////////////////////////////

    layer_QWERTY {
      display-name = "QWERTY";
      bindings = <
        // Row 0: numrow (Glove80 Row 2: &none, N1..N5 | N6..N0, &none) + mod keys
        &none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &tog LAYER_Function                                                            &mo LAYER_Lower  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none
        // Row 1: QWERTY (Glove80 Row 3: &none, Q W E R T | Y U I O P, MINUS) + mod keys
        &none  &kp Q  &kp W  &kp E  &kp R  &kp T  &none                                                                                &none  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS
        // Row 2: home row (Glove80 Row 4: EQUAL, HRM_A..G | H..HRM_SEMI, SQT) + mod + palm
        &kp EQUAL  &LeftPinky (A, LAYER_QWERTY)  &LeftRingy (S, LAYER_QWERTY)  &LeftMiddy (D, LAYER_QWERTY)  &LeftIndex (F, LAYER_QWERTY)  &kp G  &none    &thumb LAYER_Number DELETE  &mo LAYER_Lower    &thumb LAYER_Lower INSERT  &thumb LAYER_Mouse TAB    &none  &kp H  &RightIndex (J, LAYER_QWERTY)  &RightMiddy (K, LAYER_QWERTY)  &RightRingy (L, LAYER_QWERTY)  &RightPinky (SEMI, LAYER_QWERTY)  &kp SQT
        // Row 3: lower (Glove80 Row 5: sticky_shift, Z X C V B | N M , . /, sticky_shift) + middle
        &sticky_key_modtap LSFT LSFT  &kp Z  &kp X  &kp C  &kp V  &kp B    &thumb LAYER_Cursor ESC                                      &thumb LAYER_Cursor _END    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &sticky_key_modtap RSFT RSFT
        // Row 4: bottom (Glove80 Row 6: magic, GRAVE, LBKT, RBKT, Emoji_BSLH | World_PGUP, scroll_up, scroll_dn, PGDN, magic) + thumb
        &magic LAYER_Magic 0  &kp GRAVE  &kp LBKT  &kp RBKT  &thumb LAYER_Emoji BSLH    &thumb LAYER_Function BACKSPACE  &parang_left  &parang_right    &kp _HOME  &kp ENTER  &thumb LAYER_System SPACE    &thumb LAYER_World PAGE_UP  &msc MOUSE_SCROLL_UP  &msc MOUSE_SCROLL_DOWN  &kp PG_DN  &magic LAYER_Magic 0
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 1: macOS
    //
    // Overlay that swaps home row mods to macOS-style (sticky HRMs)
    // and is otherwise transparent.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_macOS {
      display-name = "macOS";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2: sticky HRMs overridden for macOS
        &trans  &LeftMiddy_layer0 (KEY_LH_C5R4)  &LeftRingy_layer0 (KEY_LH_C4R4)  &LeftPinky_layer0 (KEY_LH_C3R4)  &LeftIndex_layer0 (KEY_LH_C2R4)  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &RightIndex_layer0 (KEY_RH_C2R4)  &RightPinky_layer0 (KEY_RH_C3R4)  &RightRingy_layer0 (KEY_RH_C4R4)  &RightMiddy_layer0 (KEY_RH_C5R4)  &trans
        // Row 3
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &trans    &trans  &trans  &trans  &trans  &trans  &trans
        // Row 4
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 2: Typing
    //
    // Disables home row mods for pure typing (plain keys on home row).
    // Disables layer-tap on thumb keys too.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Typing {
      display-name = "Typing";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2: plain keys instead of HRMs + plain thumb tap keys on palm
        &trans  &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY  &trans  &trans    &kp KEY_LH_T5  &kp KEY_LH_T6    &kp KEY_RH_T6  &kp KEY_RH_T5    &trans  &trans  &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY  &trans
        // Row 3: plain thumb keys on middle
        &trans  &trans  &trans  &trans  &trans  &trans    &kp KEY_LH_T4                           &kp KEY_RH_T4    &trans  &trans  &trans  &trans  &trans  &trans
        // Row 4: plain thumb keys on T1-T3
        &trans  &trans  &trans  &trans  &kp KEY_LH_C2R6    &kp KEY_LH_T1  &trans  &trans    &trans  &trans  &kp KEY_RH_T1    &kp KEY_RH_C2R6  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 3: LeftPinky (bilateral enforcement)
    //
    // Left hand taps keys, right hand types normally.
    // Home row: &none on the triggering finger, cross-finger refs for others.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_LeftPinky {
      display-name = "LPinky";
      bindings = <
        // Row 0 (Glove80 Row 2, dropping C6R2=0 outer key)
        &left_pinky_tap KEY_LH_C6R2  &left_pinky_tap KEY_LH_C5R2  &left_pinky_tap KEY_LH_C4R2  &left_pinky_tap KEY_LH_C3R2  &left_pinky_tap KEY_LH_C2R2  &left_pinky_tap KEY_LH_C1R2  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1 (Glove80 Row 3)
        &left_pinky_tap KEY_LH_C6R3  &left_pinky_tap KEY_LH_C5R3  &left_pinky_tap KEY_LH_C4R3  &left_pinky_tap KEY_LH_C3R3  &left_pinky_tap KEY_LH_C2R3  &left_pinky_tap KEY_LH_C1R3  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2: home row (Glove80 Row 4); pinky finger = &none, others = cross-refs
        &left_pinky_tap KEY_LH_C6R4  &none  &LeftPinkyRingy  &LeftPinkyMiddy  &LeftPinkyIndex  &left_pinky_tap KEY_LH_C1R4  &trans    &mo LAY_LH_T5  &mo LAY_LH_T6    &trans  &trans    &trans  &trans  &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY  &trans
        // Row 3 (Glove80 Row 5)
        &trans  &left_pinky_tap KEY_LH_C5R5  &left_pinky_tap KEY_LH_C4R5  &left_pinky_tap KEY_LH_C3R5  &left_pinky_tap KEY_LH_C2R5  &left_pinky_tap KEY_LH_C1R5    &mo LAY_LH_T4                                     &trans    &trans  &trans  &trans  &trans  &trans  &trans
        // Row 4 (Glove80 Row 6 + thumb T1-T3)
        &trans  &left_pinky_tap KEY_LH_C5R6  &left_pinky_tap KEY_LH_C4R6  &left_pinky_tap KEY_LH_C3R6  &mo LAY_LH_C2R6    &mo LAY_LH_T1  &left_pinky_tap KEY_LH_T2  &left_pinky_tap KEY_LH_T3    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 4: LeftRingy (bilateral enforcement)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_LeftRingy {
      display-name = "LRingy";
      bindings = <
        // Row 0
        &left_ringy_tap KEY_LH_C6R2  &left_ringy_tap KEY_LH_C5R2  &left_ringy_tap KEY_LH_C4R2  &left_ringy_tap KEY_LH_C3R2  &left_ringy_tap KEY_LH_C2R2  &left_ringy_tap KEY_LH_C1R2  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1
        &left_ringy_tap KEY_LH_C6R3  &left_ringy_tap KEY_LH_C5R3  &left_ringy_tap KEY_LH_C4R3  &left_ringy_tap KEY_LH_C3R3  &left_ringy_tap KEY_LH_C2R3  &left_ringy_tap KEY_LH_C1R3  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2: home row; ringy finger = &none
        &left_ringy_tap KEY_LH_C6R4  &LeftRingyPinky  &none  &LeftRingyMiddy  &LeftRingyIndex  &left_ringy_tap KEY_LH_C1R4  &trans    &mo LAY_LH_T5  &mo LAY_LH_T6    &trans  &trans    &trans  &trans  &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY  &trans
        // Row 3
        &trans  &left_ringy_tap KEY_LH_C5R5  &left_ringy_tap KEY_LH_C4R5  &left_ringy_tap KEY_LH_C3R5  &left_ringy_tap KEY_LH_C2R5  &left_ringy_tap KEY_LH_C1R5    &mo LAY_LH_T4                                     &trans    &trans  &trans  &trans  &trans  &trans  &trans
        // Row 4
        &trans  &left_ringy_tap KEY_LH_C5R6  &left_ringy_tap KEY_LH_C4R6  &left_ringy_tap KEY_LH_C3R6  &mo LAY_LH_C2R6    &mo LAY_LH_T1  &left_ringy_tap KEY_LH_T2  &left_ringy_tap KEY_LH_T3    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 5: LeftMiddy (bilateral enforcement)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_LeftMiddy {
      display-name = "LMiddy";
      bindings = <
        // Row 0
        &left_middy_tap KEY_LH_C6R2  &left_middy_tap KEY_LH_C5R2  &left_middy_tap KEY_LH_C4R2  &left_middy_tap KEY_LH_C3R2  &left_middy_tap KEY_LH_C2R2  &left_middy_tap KEY_LH_C1R2  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1
        &left_middy_tap KEY_LH_C6R3  &left_middy_tap KEY_LH_C5R3  &left_middy_tap KEY_LH_C4R3  &left_middy_tap KEY_LH_C3R3  &left_middy_tap KEY_LH_C2R3  &left_middy_tap KEY_LH_C1R3  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2: home row; middy finger = &none
        &left_middy_tap KEY_LH_C6R4  &LeftMiddyPinky  &LeftMiddyRingy  &none  &LeftMiddyIndex  &left_middy_tap KEY_LH_C1R4  &trans    &mo LAY_LH_T5  &mo LAY_LH_T6    &trans  &trans    &trans  &trans  &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY  &trans
        // Row 3
        &trans  &left_middy_tap KEY_LH_C5R5  &left_middy_tap KEY_LH_C4R5  &left_middy_tap KEY_LH_C3R5  &left_middy_tap KEY_LH_C2R5  &left_middy_tap KEY_LH_C1R5    &mo LAY_LH_T4                                     &trans    &trans  &trans  &trans  &trans  &trans  &trans
        // Row 4
        &trans  &left_middy_tap KEY_LH_C5R6  &left_middy_tap KEY_LH_C4R6  &left_middy_tap KEY_LH_C3R6  &mo LAY_LH_C2R6    &mo LAY_LH_T1  &left_middy_tap KEY_LH_T2  &left_middy_tap KEY_LH_T3    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 6: LeftIndex (bilateral enforcement)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_LeftIndex {
      display-name = "LIndex";
      bindings = <
        // Row 0
        &left_index_tap KEY_LH_C6R2  &left_index_tap KEY_LH_C5R2  &left_index_tap KEY_LH_C4R2  &left_index_tap KEY_LH_C3R2  &left_index_tap KEY_LH_C2R2  &left_index_tap KEY_LH_C1R2  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1
        &left_index_tap KEY_LH_C6R3  &left_index_tap KEY_LH_C5R3  &left_index_tap KEY_LH_C4R3  &left_index_tap KEY_LH_C3R3  &left_index_tap KEY_LH_C2R3  &left_index_tap KEY_LH_C1R3  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2: home row; index finger = &none
        &left_index_tap KEY_LH_C6R4  &LeftIndexPinky  &LeftIndexRingy  &LeftIndexMiddy  &none  &left_index_tap KEY_LH_C1R4  &trans    &mo LAY_LH_T5  &mo LAY_LH_T6    &trans  &trans    &trans  &trans  &kp RIGHT_INDEX_KEY  &kp RIGHT_MIDDY_KEY  &kp RIGHT_RINGY_KEY  &kp RIGHT_PINKY_KEY  &trans
        // Row 3
        &trans  &left_index_tap KEY_LH_C5R5  &left_index_tap KEY_LH_C4R5  &left_index_tap KEY_LH_C3R5  &left_index_tap KEY_LH_C2R5  &left_index_tap KEY_LH_C1R5    &mo LAY_LH_T4                                     &trans    &trans  &trans  &trans  &trans  &trans  &trans
        // Row 4
        &trans  &left_index_tap KEY_LH_C5R6  &left_index_tap KEY_LH_C4R6  &left_index_tap KEY_LH_C3R6  &mo LAY_LH_C2R6    &mo LAY_LH_T1  &left_index_tap KEY_LH_T2  &left_index_tap KEY_LH_T3    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 7: RightPinky (bilateral enforcement)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_RightPinky {
      display-name = "RPinky";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &right_pinky_tap KEY_RH_C1R2  &right_pinky_tap KEY_RH_C2R2  &right_pinky_tap KEY_RH_C3R2  &right_pinky_tap KEY_RH_C4R2  &right_pinky_tap KEY_RH_C5R2  &right_pinky_tap KEY_RH_C6R2
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &right_pinky_tap KEY_RH_C1R3  &right_pinky_tap KEY_RH_C2R3  &right_pinky_tap KEY_RH_C3R3  &right_pinky_tap KEY_RH_C4R3  &right_pinky_tap KEY_RH_C5R3  &right_pinky_tap KEY_RH_C6R3
        // Row 2: home row; pinky finger = &none
        &trans  &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY  &trans  &trans    &trans  &trans    &mo LAY_RH_T6  &mo LAY_RH_T5    &trans  &right_pinky_tap KEY_RH_C1R4  &RightPinkyIndex  &RightPinkyMiddy  &RightPinkyRingy  &none  &right_pinky_tap KEY_RH_C6R4
        // Row 3
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &mo LAY_RH_T4    &right_pinky_tap KEY_RH_C1R5  &right_pinky_tap KEY_RH_C2R5  &right_pinky_tap KEY_RH_C3R5  &right_pinky_tap KEY_RH_C4R5  &right_pinky_tap KEY_RH_C5R5  &trans
        // Row 4
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &right_pinky_tap KEY_RH_T3  &right_pinky_tap KEY_RH_T2  &mo LAY_RH_T1    &mo LAY_RH_C2R6  &right_pinky_tap KEY_RH_C3R6  &right_pinky_tap KEY_RH_C4R6  &right_pinky_tap KEY_RH_C5R6  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 8: RightRingy (bilateral enforcement)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_RightRingy {
      display-name = "RRingy";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &right_ringy_tap KEY_RH_C1R2  &right_ringy_tap KEY_RH_C2R2  &right_ringy_tap KEY_RH_C3R2  &right_ringy_tap KEY_RH_C4R2  &right_ringy_tap KEY_RH_C5R2  &right_ringy_tap KEY_RH_C6R2
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &right_ringy_tap KEY_RH_C1R3  &right_ringy_tap KEY_RH_C2R3  &right_ringy_tap KEY_RH_C3R3  &right_ringy_tap KEY_RH_C4R3  &right_ringy_tap KEY_RH_C5R3  &right_ringy_tap KEY_RH_C6R3
        // Row 2: home row; ringy finger = &none
        &trans  &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY  &trans  &trans    &trans  &trans    &mo LAY_RH_T6  &mo LAY_RH_T5    &trans  &right_ringy_tap KEY_RH_C1R4  &RightRingyIndex  &RightRingyMiddy  &none  &RightRingyPinky  &right_ringy_tap KEY_RH_C6R4
        // Row 3
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &mo LAY_RH_T4    &right_ringy_tap KEY_RH_C1R5  &right_ringy_tap KEY_RH_C2R5  &right_ringy_tap KEY_RH_C3R5  &right_ringy_tap KEY_RH_C4R5  &right_ringy_tap KEY_RH_C5R5  &trans
        // Row 4
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &right_ringy_tap KEY_RH_T3  &right_ringy_tap KEY_RH_T2  &mo LAY_RH_T1    &mo LAY_RH_C2R6  &right_ringy_tap KEY_RH_C3R6  &right_ringy_tap KEY_RH_C4R6  &right_ringy_tap KEY_RH_C5R6  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 9: RightMiddy (bilateral enforcement)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_RightMiddy {
      display-name = "RMiddy";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &right_middy_tap KEY_RH_C1R2  &right_middy_tap KEY_RH_C2R2  &right_middy_tap KEY_RH_C3R2  &right_middy_tap KEY_RH_C4R2  &right_middy_tap KEY_RH_C5R2  &right_middy_tap KEY_RH_C6R2
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &right_middy_tap KEY_RH_C1R3  &right_middy_tap KEY_RH_C2R3  &right_middy_tap KEY_RH_C3R3  &right_middy_tap KEY_RH_C4R3  &right_middy_tap KEY_RH_C5R3  &right_middy_tap KEY_RH_C6R3
        // Row 2: home row; middy finger = &none
        &trans  &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY  &trans  &trans    &trans  &trans    &mo LAY_RH_T6  &mo LAY_RH_T5    &trans  &right_middy_tap KEY_RH_C1R4  &RightMiddyIndex  &none  &RightMiddyRingy  &RightMiddyPinky  &right_middy_tap KEY_RH_C6R4
        // Row 3
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &mo LAY_RH_T4    &right_middy_tap KEY_RH_C1R5  &right_middy_tap KEY_RH_C2R5  &right_middy_tap KEY_RH_C3R5  &right_middy_tap KEY_RH_C4R5  &right_middy_tap KEY_RH_C5R5  &trans
        // Row 4
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &right_middy_tap KEY_RH_T3  &right_middy_tap KEY_RH_T2  &mo LAY_RH_T1    &mo LAY_RH_C2R6  &right_middy_tap KEY_RH_C3R6  &right_middy_tap KEY_RH_C4R6  &right_middy_tap KEY_RH_C5R6  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 10: RightIndex (bilateral enforcement)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_RightIndex {
      display-name = "RIndex";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &right_index_tap KEY_RH_C1R2  &right_index_tap KEY_RH_C2R2  &right_index_tap KEY_RH_C3R2  &right_index_tap KEY_RH_C4R2  &right_index_tap KEY_RH_C5R2  &right_index_tap KEY_RH_C6R2
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &right_index_tap KEY_RH_C1R3  &right_index_tap KEY_RH_C2R3  &right_index_tap KEY_RH_C3R3  &right_index_tap KEY_RH_C4R3  &right_index_tap KEY_RH_C5R3  &right_index_tap KEY_RH_C6R3
        // Row 2: home row; index finger = &none
        &trans  &kp LEFT_PINKY_KEY  &kp LEFT_RINGY_KEY  &kp LEFT_MIDDY_KEY  &kp LEFT_INDEX_KEY  &trans  &trans    &trans  &trans    &mo LAY_RH_T6  &mo LAY_RH_T5    &trans  &right_index_tap KEY_RH_C1R4  &none  &RightIndexMiddy  &RightIndexRingy  &RightIndexPinky  &right_index_tap KEY_RH_C6R4
        // Row 3
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &mo LAY_RH_T4    &right_index_tap KEY_RH_C1R5  &right_index_tap KEY_RH_C2R5  &right_index_tap KEY_RH_C3R5  &right_index_tap KEY_RH_C4R5  &right_index_tap KEY_RH_C5R5  &trans
        // Row 4
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &right_index_tap KEY_RH_T3  &right_index_tap KEY_RH_T2  &mo LAY_RH_T1    &mo LAY_RH_C2R6  &right_index_tap KEY_RH_C3R6  &right_index_tap KEY_RH_C4R6  &right_index_tap KEY_RH_C5R6  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 11: Cursor
    //
    // Navigation and editing: arrows, word/line selection, undo/redo.
    // Left hand: editing actions. Right hand: movement.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Cursor {
      display-name = "Cursor";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 1
        &none  &kp ESC  &kp INS  &kp LS(TAB)  &kp DEL  &none  &none                                         &none  &none  &none  &none  &none  &none  &none
        // Row 2: editing + mods on left; movement on right
        &none  &kp RET  &kp SPACE  &kp TAB  &kp BSPC  &kp _CUT  &none    &none  &none    &none  &none    &none  &kp _CUT  &kp LS(TAB)  &kp _UNDO  &kp _REDO  &kp TAB  &none
        // Row 3: mods + selection on left; arrows on right
        &sk LSHFT  &kp LEFT_PINKY_MOD  &kp LEFT_RINGY_MOD  &kp LEFT_MIDDY_MOD  &kp LEFT_INDEX_MOD  &kp _COPY    &none                                     &none    &kp _COPY  &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT  &sk LSHFT
        // Row 4: selection tools on left; page nav on right
        &kp _C(L)  &select_all  &select_line  &select_word  &kp _FIND    &none  &none  &none    &select_none  &extend_line  &extend_word    &kp _PASTE  &kp _HOME  &kp PG_UP  &kp PG_DN  &kp _END
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 12: Number
    //
    // Number pad on right hand, editing on left hand.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Number {
      display-name = "Number";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &kp A  &kp B  &kp C  &kp D  &kp E  &none
        // Row 1
        &none  &kp ESC  &kp INS  &kp LS(TAB)  &kp DEL  &none  &none                                         &none  &kp LS(BSLH)  &kp LS(N3)  &kp LS(N4)  &kp LS(N6)  &kp LS(GRAVE)  &kp LS(N1)
        // Row 2: editing on left; numpad on right
        &kp E  &kp RET  &kp SPACE  &kp TAB  &kp BSPC  &kp N0  &none    &tog LAYER_Number  &none    &none  &none    &none  &kp LS(G)  &kp N7  &kp N8  &kp N9  &kp LS(SEMI)  &kp LS(N5)
        // Row 3: mods on left; numbers 4-6 on right
        &sk LSHFT  &kp LEFT_PINKY_MOD  &kp LEFT_RINGY_MOD  &kp LEFT_MIDDY_MOD  &kp LEFT_INDEX_MOD  &kp X    &none                                     &none    &kp K  &kp N4  &kp N5  &kp N6  &kp MINUS  &kp LS(EQUAL)
        // Row 4: find/undo on left; numbers 1-3 + operators on right
        &kp LS(MINUS)  &select_all  &select_line  &select_word  &kp _FIND    &none  &none  &none    &kp LS(COMMA)  &kp LS(DOT)  &kp COMMA    &kp J  &kp N1  &kp N2  &kp N3  &kp FSLH
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 13: Function
    //
    // F1-F15 on right hand, media controls, editing on left.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Function {
      display-name = "Fn";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 1
        &none  &kp ESC  &kp INS  &kp LS(TAB)  &kp DEL  &none  &none                                         &none  &kp C_MEDIA_HOME  &kp C_PLAY  &kp C_PREV  &kp C_NEXT  &kp C_STOP  &kp C_EJECT
        // Row 2: editing on left; F7-F10 on right
        &none  &kp RET  &kp SPACE  &kp TAB  &kp BSPC  &kp K_CALC  &none    &none  &none    &none  &none    &none  &kp K_CALC  &kp F7  &kp F8  &kp F9  &kp F10  &kp F13
        // Row 3: mods on left; F4-F6 on right
        &sk LSHFT  &kp LEFT_PINKY_MOD  &kp LEFT_RINGY_MOD  &kp LEFT_MIDDY_MOD  &kp LEFT_INDEX_MOD  &kp K_WWW    &none                                     &none    &kp K_WWW  &kp F4  &kp F5  &kp F6  &kp F11  &kp F14
        // Row 4: undo/redo on left; F1-F3 + media on right
        &none  &select_all  &select_line  &select_word  &kp _FIND    &tog LAYER_Function  &none  &none    &kp C_PP  &kp C_PREV  &kp C_NEXT    &kp _FILES  &kp F1  &kp F2  &kp F3  &kp F12
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 14: Emoji
    //
    // Emoji macros across the entire keyboard.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Emoji {
      display-name = "Emoji";
      bindings = <
        // Row 0
        &emoji_cloudy  &emoji_mostly_cloudy  &emoji_partly_cloudy  &emoji_mostly_sunny  &emoji_sunny  &none  &none                                     &none  &none  &emoji_new_moon  &emoji_moon_crescent  &emoji_moon_quarter  &emoji_moon_gibbous  &emoji_full_moon
        // Row 1
        &emoji_rainbow  &emoji_light_skin_tone  &emoji_medium_light_skin_tone  &emoji_medium_skin_tone  &emoji_medium_dark_skin_tone  &emoji_dark_skin_tone  &none                                     &none  &emoji_theme_party  &emoji_theme_love  &emoji_theme_nature  &emoji_theme_strength  &emoji_theme_effort  &emoji_theme_science
        // Row 2
        &emoji_left_arrow  &emoji_bald  &emoji_red_hair  &emoji_curly_hair  &emoji_white_hair  &emoji_right_arrow  &none    &none  &none    &none  &none    &none  &emoji_face_laugh  &emoji_face_smile  &emoji_face_eyes  &emoji_face_joke  &emoji_face_fear  &emoji_face_surprise
        // Row 3
        &emoji_male_sign  &emoji_hair_style_preset  &emoji_skin_tone_preset  &emoji_gender_sign_preset  &sk LSHFT  &emoji_female_sign    &none                                     &none    &emoji_gesture_attention  &emoji_gesture_approval  &emoji_gesture_gratitude  &emoji_gesture_anxiety  &emoji_gesture_despair  &emoji_gesture_curious
        // Row 4
        &emoji_old_man  &emoji_man  &emoji_boy  &emoji_girl  &emoji_woman    &emoji_old_woman  &emoji_cityscape  &emoji_cityscape_dusk    &emoji_cityscape_night  &emoji_theme_magic  &emoji_theme_space    &emoji_theme_awesome  &emoji_person_tipping_hand  &emoji_person_gesturing_ok  &emoji_person_bowing  &emoji_person_raising_hand
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 15: World
    //
    // International characters (accented vowels, special consonants, etc.)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_World {
      display-name = "World";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 1
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 2: accented vowels on left; sticky mods on right
        &none  &none  &world_y_base  &world_o_base  &world_u_base  &world_sign_angle  &none    &none  &none    &none  &none    &none  &none  &none  &sk LALT  &sk RALT  &none  &none
        // Row 3: consonants + accented vowels on left; sticky mods on right
        &none  &world_consonants_base  &world_i_base  &world_a_base  &world_e_base  &world_sign_dash    &none                                     &none    &none  &sk LSHFT  &sk LCTRL  &sk RCTRL  &sk RSHFT  &none
        // Row 4: currency + quotes on left; toggle on right
        &world_currency_base  &world_quotes_left_base  &world_sign_landmark  &world_sign_ordinal  &world_sign_exclaim    &world_sign_question  &none  &none    &none  &none  &none    &none  &tog LAYER_World  &none  &none  &none
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 16: Symbol
    //
    // Programming symbols on left hand, editing on right hand.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Symbol {
      display-name = "Symbol";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 1: backticks, parens, delimiters
        &triple_backtick  &kp GRAVE  &kp LS(N9)  &kp LS(N0)  &kp SEMI  &kp COMMA  &none                     &none  &none  &none  &none  &none  &none  &none
        // Row 2: brackets, operators
        &kp LS(N1)  &kp LBKT  &kp LS(LBKT)  &kp LS(RBKT)  &kp RBKT  &kp LS(FSLH)  &none    &none  &none    &none  &none    &none  &kp DOT  &kp DEL  &kp LS(TAB)  &kp INS  &kp ESC  &none
        // Row 3: math symbols, comparisons
        &kp LS(N3)  &kp LS(N6)  &kp EQUAL  &kp LS(MINUS)  &kp LS(N4)  &kp LS(N8)    &none                   &none    &kp COMMA  &kp BSPC  &kp TAB  &kp SPACE  &kp RET  &none
        // Row 4: remaining symbols
        &kp LS(GRAVE)  &kp LS(COMMA)  &kp LS(BSLH)  &kp MINUS  &kp LS(DOT)    &kp FSLH  &kp BSLH  &kp DOT    &kp LS(N8)  &none  &none    &none  &kp LS(SINGLE_QUOTE)  &kp SQT  &kp GRAVE  &kp BSLH
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 17: System
    //
    // RGB underglow, system keys, lock/sleep/power.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_System {
      display-name = "System";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 1
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 2: RGB controls
        &none  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &none    &none  &none    &none  &none    &none  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &none
        // Row 3: RGB controls (reverse)
        &none  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFR    &none                                     &none    &rgb_ug RGB_EFR  &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &none
        // Row 4: system keys
        &none  &none  &kp K_APP  &kp PSCRN  &kp PAUSE_BREAK    &rgb_ug RGB_TOG  &kp _LOCK  &kp _SLEEP    &kp _POWER  &linux_magic_sysrq  &tog LAYER_System    &rgb_ug RGB_TOG  &kp SLCK  &kp KP_NUM  &kp CAPS  &kp _LOCK
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 18: Mouse
    //
    // Mouse movement on both hands, scroll, click buttons.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Mouse {
      display-name = "Mouse";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 1
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 2: scroll + movement on left; click + scroll on right
        &none  &none  &msc MOUSE_SCROLL_LEFT  &mmv MOVE_UP  &msc MOUSE_SCROLL_RIGHT  &none  &none    &none  &none    &none  &none    &none  &msc MOUSE_SCROLL_LEFT  &mkp LCLK  &mkp MCLK  &mkp RCLK  &msc MOUSE_SCROLL_RIGHT  &none
        // Row 3: scroll + movement on left; speed layers + app on right
        &none  &msc MOUSE_SCROLL_UP  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc MOUSE_SCROLL_UP    &none                                     &none    &msc MOUSE_SCROLL_UP  &mo LAYER_MouseFast  &mo LAYER_MouseSlow  &mo LAYER_MouseWarp  &kp K_APP  &mkp MB4
        // Row 4: scroll + clipboard on left; movement + speed on right
        &none  &msc MOUSE_SCROLL_DOWN  &kp _CUT  &kp _COPY  &kp _PASTE    &msc MOUSE_SCROLL_DOWN  &mkp MCLK  &kp K_APP    &mkp MB5  &kp _CUT  &kp _COPY    &kp _PASTE  &msc MOUSE_SCROLL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 19: MouseSlow (transparent speed override)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_MouseSlow {
      display-name = "MsSlow";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &trans    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 20: MouseFast (transparent speed override)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_MouseFast {
      display-name = "MsFast";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &trans    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 21: MouseWarp (transparent speed override)
    //
    //////////////////////////////////////////////////////////////////////////

    layer_MouseWarp {
      display-name = "MsWarp";
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &trans    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 22: Gaming
    //
    // Gaming layout with WASD-centric left hand, standard right hand.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Gaming {
      display-name = "Gaming";
      bindings = <
        // Row 0
        &kp ESC  &kp P  &kp O  &kp N  &kp BSPC  &none  &none                                                &none  &none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
        // Row 1
        &kp M  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none                                                &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
        // Row 2
        &kp I  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none    &none  &none    &none  &none    &none  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp F12
        // Row 3
        &kp T  &kp TAB  &kp Q  &kp W  &kp E  &kp R    &none                                                  &none    &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
        // Row 4
        &kp G  &kp LSHFT  &kp A  &kp S  &kp D    &kp F  &kp LSHFT  &kp LALT    &kp V  &kp ESC  &kp UP    &kp RET  &kp N  &kp M  &kp COMMA  &kp DOT
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 23: Factory
    //
    // Standard QWERTY factory-default-style layout for recovery.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Factory {
      display-name = "Factory";
      bindings = <
        // Row 0
        &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none                                            &none  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
        // Row 1
        &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &none                                                   &none  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH
        // Row 2
        &kp ESC  &kp A  &kp S  &kp D  &kp F  &kp G  &none    &kp LCTRL  &mo LAYER_Lower    &kp LGUI  &kp RCTRL    &none  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
        // Row 3
        &kp GRAVE  &kp Z  &kp X  &kp C  &kp V  &kp B    &kp LSHFT                                           &kp RSHFT    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp PG_UP
        // Row 4
        &magic LAYER_Magic 0  &kp HOME  &kp END  &kp LEFT  &kp RIGHT    &kp BSPC  &kp DEL  &kp LALT    &kp RALT  &kp RET  &kp SPACE    &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &kp PG_DN
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 24: Lower
    //
    // Keypad numbers, sticky mods, and layer toggles.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Lower {
      display-name = "Lower";
      bindings = <
        // Row 0
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 1
        &none  &none  &none  &none  &none  &none  &none                                                      &none  &none  &none  &none  &none  &none  &none
        // Row 2: KP digits 1-5 on left; KP digits 6-0 on right
        &none  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4  &kp KP_N5  &none    &none  &none    &none  &none    &none  &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0  &none
        // Row 3: sticky mods on left; KP operators on right
        &none  &sk LEFT_PINKY_MOD  &sk LEFT_RINGY_MOD  &sk LEFT_MIDDY_MOD  &sk LEFT_INDEX_MOD  &kp KP_MINUS    &tog LAYER_Function                                     &tog LAYER_System    &kp KP_SLASH  &sk RIGHT_INDEX_MOD  &sk RIGHT_MIDDY_MOD  &sk RIGHT_RINGY_MOD  &sk RIGHT_PINKY_MOD  &none
        // Row 4: KP grouping + layer toggles
        &none  &kp KP_LPAR  &kp KP_COMMA  &kp KP_DOT  &kp KP_RPAR    &kp KP_PLUS  &none  &kp RALT    &kp RALT  &none  &none    &kp KP_MULTIPLY  &kp KP_NUM  &kp KP_CLEAR  &kp KP_EQUAL  &kp KP_ENTER
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 25: macOS_left (conditional: macOS + left-hand layers)
    //
    // Overrides left-hand sticky mods for macOS modifier order.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_macOS_left {
      display-name = "mOSlft";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2: macOS-style mods on left home row
        &trans  &kp LEFT_MIDDY_MOD  &kp LEFT_RINGY_MOD  &kp LEFT_PINKY_MOD  &kp LEFT_INDEX_MOD  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 3
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &trans    &trans  &trans  &trans  &trans  &trans  &trans
        // Row 4
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 26: macOS_right (conditional: macOS + right-hand layers)
    //
    // Overrides right-hand sticky mods for macOS modifier order.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_macOS_right {
      display-name = "mOSrgt";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 3
        &trans  &trans  &trans  &trans  &trans  &trans    &trans                                   &trans    &trans  &trans  &trans  &trans  &trans  &trans
        // Row 4: macOS-style mods on right bottom row
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &kp RIGHT_INDEX_MOD  &kp RIGHT_PINKY_MOD  &kp RIGHT_RINGY_MOD  &kp RIGHT_MIDDY_MOD  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 27: macOS_lower (conditional: macOS + Lower)
    //
    // Overrides sticky mods on both hands for macOS modifier order.
    //
    //////////////////////////////////////////////////////////////////////////

    layer_macOS_lower {
      display-name = "mOSlwr";
      bindings = <
        // Row 0
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 1
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 2
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        // Row 3: macOS-style mods on both home rows
        &trans  &kp LEFT_MIDDY_MOD  &kp LEFT_RINGY_MOD  &kp LEFT_PINKY_MOD  &kp LEFT_INDEX_MOD  &trans    &trans                                     &trans    &trans  &kp RIGHT_INDEX_MOD  &kp RIGHT_PINKY_MOD  &kp RIGHT_RINGY_MOD  &kp RIGHT_MIDDY_MOD  &trans
        // Row 4
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
      >;
    };

    //////////////////////////////////////////////////////////////////////////
    //
    // Layer 28: Magic
    //
    // Layer switching, Bluetooth profiles, RGB toggle, bootloader, reset.
    // Enthium/Colemak/Dvorak slots replaced with &none (QWERTY-only).
    //
    //////////////////////////////////////////////////////////////////////////

    layer_Magic {
      display-name = "Magic";
      bindings = <
        // Row 0: BT clear + profiles
        &bt BT_CLR  &none  &none  &none  &none  &none  &none                                                 &none  &none  &none  &none  &none  &none  &bt BT_CLR_ALL
        // Row 1: base layer select (only QWERTY + macOS/Typing toggles)
        &to 0  &none  &none  &none  &tog LAYER_macOS  &tog LAYER_Typing  &none                               &none  &none  &none  &none  &none  &none  &none
        // Row 2: RGB controls
        &none  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG  &none    &none  &none    &none  &none    &none  &none  &none  &none  &none  &none  &none
        // Row 3: RGB reverse + bootloader
        &bootloader  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF    &none                                     &none    &none  &none  &none  &none  &none  &bootloader
        // Row 4: reset + BT profiles (0-4) + USB output + factory
        &sys_reset  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &out OUT_USB  &tog LAYER_Factory    &none  &none  &none    &none  &none  &none  &tog LAYER_macOS  &sys_reset
      >;
    };

  };
};
