        &emoji_male_sign  &emoji_hair_style_preset  &emoji_skin_tone_preset  &emoji_gender_sign_preset  &sk LSHFT  &emoji_female_sign    &none                                     &none    &emoji_gesture_attention  &emoji_gesture_approval  &emoji_gesture_gratitude  &emoji_gesture_anxiety  &emoji_gesture_despair  &emoji_gesture_curious
        // Row 4
        &emoji_old_man  &emoji_man  &emoji_boy  &emoji_girl  &emoji_woman    &emoji_old_woman  &emoji_cityscape  &emoji_cityscape_dusk    &emoji_cityscape_night  &emoji_theme_magic  &emoji_theme_space    &emoji_theme_awesome  &emoji_person_tipping_hand  &emoji_person_gesturing_ok  &emoji_person_bowing  &emoji_person_raising_hand
      >;
